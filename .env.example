# 首次部署：复制为 .env，然后替换所有 REPLACE_WITH_* 和 example.com。
# 密码会进入 PostgreSQL URL，请分别使用至少 20 位的字母、数字、下划线和短横线组合。

# Public entry
# 有域名：PUBLIC_HOST=scholar.example.com，Caddy 自动申请 HTTPS 证书。
# 仅公网 IP：PUBLIC_HOST=:80，同时使用 http://IP 和 COOKIE_SECURE=false。
PUBLIC_HOST=scholar.example.com
PUBLIC_APP_URL=https://scholar.example.com
CORS_ALLOWED_ORIGINS=https://scholar.example.com
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL (server-side only)
POSTGRES_DB=scholar_profile
POSTGRES_OWNER_USER=scholar_owner
POSTGRES_OWNER_PASSWORD=REPLACE_WITH_OWNER_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_APP_PASSWORD
POSTGRES_PORT=55432

# Web/Auth
APP_ENV=production
COOKIE_SECURE=true
SESSION_COOKIE_NAME=scholar_session
SESSION_TTL_DAYS=30
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=10
WORKFLOW_VERSION=1
RATE_LIMIT_WINDOW_SECONDS=600
SEARCH_RATE_LIMIT_PER_USER=30
SEARCH_RATE_LIMIT_PER_IP=120
PROFILE_RATE_LIMIT_PER_USER=12
PROFILE_RATE_LIMIT_PER_IP=60
WORKER_POLL_SECONDS=3
WORKER_MAINTENANCE_SECONDS=3600
# Optional until personal API-key submission is enabled over HTTPS.
CREDENTIAL_ENCRYPTION_KEY=

# OpenAlex server key. Keep it only in the server .env and never commit the real value.
OPENALEX_API_KEY=
OPENALEX_SEARCH_CACHE_TTL_SECONDS=86400
OPENALEX_EMPTY_SEARCH_CACHE_TTL_SECONDS=900
OPENALEX_INCOMPLETE_SEARCH_CACHE_TTL_SECONDS=300
OPENALEX_LOCAL_SEARCH_CACHE_TTL_SECONDS=3600
OPENALEX_IDENTITY_CACHE_TTL_SECONDS=2592000
OPENALEX_SEARCH_COALESCE_WAIT_SECONDS=25
OPENALEX_SEARCH_COALESCE_POLL_SECONDS=0.1
OPENALEX_MIN_REMAINING_CREDITS=200

# Optional OpenAI-compatible routed LLM agents; empty values use deterministic fallback logic.
# LongCat is tried first; the existing LLM_* provider is used as the fallback.
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.chat/openai
LONGCAT_MODEL=LongCat-2.0
LLM_API_KEY=
LLM_BASE_URL=
LLM_FAST_MODEL=
LLM_STRONG_MODEL=
LLM_ROUTER_MODE=auto
LLM_STRONG_DAILY_LIMIT=100

# Optional Google Scholar verification through SerpApi. Empty values skip this source.
SERPAPI_API_KEY=

# Backup
BACKUP_HOST_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
